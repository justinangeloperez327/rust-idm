import { VerticalBox, HorizontalBox, Button, LineEdit, ScrollView } from "std-widgets.slint";

export struct DownloadRow {
    id: int,
    name: string,
    status: string,
    progress: int,
    url: string,
}

export component MainWindow inherits Window {
    title: "Rust IDM";
    preferred-width: 1080px;
    preferred-height: 700px;
    min-width: 720px;
    min-height: 480px;

    in-out property <bool> dark-mode: true;
    in-out property <string> selected-page: "All Downloads";
    in property <[DownloadRow]> downloads;
    in-out property <int> selected-id: -1;
    callback add-download(string);
    callback download-action(int, string);
    callback transfer-finished(int);
    in-out property <string> transfer-message: "Select a download and click Start.";
    in-out property <int> max-concurrent: 3;
    in-out property <int> global-limit-kib: 0;
    callback apply-settings(int, int);

    background: dark-mode ? #111318 : #f4f5f7;
    private property <brush> ink: dark-mode ? #edf0f4 : #202630;
    private property <brush> muted: dark-mode ? #9ba3b2 : #626b79;
    private property <brush> surface: dark-mode ? #1c2028 : #ffffff;

    HorizontalBox {
        spacing: 0px;
        Rectangle {
            width: 215px;
            background: surface;
            VerticalBox {
                padding: 18px;
                spacing: 10px;
                Text { text: "RUST IDM"; font-size: 22px; font-weight: 700; color: ink; }
                Text { text: "DOWNLOAD MANAGER"; font-size: 11px; color: muted; }
                Rectangle { height: 1px; background: dark-mode ? #343b47 : #d9dee6; }
                for page in ["All Downloads", "Active", "Completed", "Paused", "Failed", "Settings"] : Button {
                    text: page;
                    clicked => { selected-page = page; }
                }
                Rectangle { vertical-stretch: 1; }
                Button {
                    text: dark-mode ? "Light appearance" : "Dark appearance";
                    clicked => { dark-mode = !dark-mode; }
                }
                Text { text: "Group 11 • Download list"; font-size: 11px; color: muted; }
            }
        }
        VerticalBox {
            padding: 22px;
            spacing: 14px;
            Text { text: selected-page; font-size: 26px; font-weight: 700; color: ink; }
            Text { text: transfer-message; font-size: 12px; color: muted; wrap: word-wrap; }
            HorizontalBox {
                spacing: 8px;
                url-input := LineEdit { placeholder-text: "Paste an HTTP or HTTPS URL"; }
                Button {
                    text: "Add URL";
                    clicked => {
                        add-download(url-input.text);
                        url-input.text = "";
                    }
                }
            }
            if (selected-page == "Settings") : Rectangle {
                background: surface;
                border-radius: 5px;
                vertical-stretch: 1;
                VerticalBox {
                    padding: 24px;
                    spacing: 14px;
                    Text { text: "Transfer settings"; color: ink; font-size: 20px; font-weight: 700; }
                    Text { text: "Maximum concurrent downloads (1–16)"; color: muted; }
                    HorizontalBox {
                        Button { text: "−"; enabled: max-concurrent > 1; clicked => { max-concurrent -= 1; } }
                        Text { text: max-concurrent; color: ink; }
                        Button { text: "+"; enabled: max-concurrent < 16; clicked => { max-concurrent += 1; } }
                    }
                    Text { text: "Shared bandwidth limit (KiB/s; 0 = unlimited)"; color: muted; }
                    HorizontalBox {
                        Button { text: "− 256"; enabled: global-limit-kib >= 256; clicked => { global-limit-kib -= 256; } }
                        Text { text: global-limit-kib; color: ink; }
                        Button { text: "+ 256"; enabled: global-limit-kib <= 1048320; clicked => { global-limit-kib += 256; } }
                    }
                    Button {
                        text: "Apply settings";
                        clicked => {
                            apply-settings(max-concurrent, global-limit-kib);
                        }
                    }
                    Text { text: "Settings apply immediately and are restored on restart."; color: muted; }
                    Rectangle { vertical-stretch: 1; }
                }
            }
            if (selected-page != "Settings") : Rectangle {
                background: surface;
                border-radius: 5px;
                vertical-stretch: 1;
                VerticalBox {
                    padding: 14px;
                    spacing: 9px;
                    HorizontalBox {
                        Text { text: "Name / Source"; horizontal-stretch: 3; color: muted; }
                        Text { text: "Status"; horizontal-stretch: 1; color: muted; }
                        Text { text: "Progress"; horizontal-stretch: 1; color: muted; }
                    }
                    Rectangle { height: 1px; background: dark-mode ? #343b47 : #e4e7ec; }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalBox {
                            spacing: 6px;
                            for download in downloads : Rectangle {
                                height: 74px;
                                background: selected-id == download.id ? (dark-mode ? #303b4d : #dce9f7) : surface;
                                border-radius: 4px;
                                if (selected-page == "All Downloads"
                                    || (selected-page == "Active" && download.status == "downloading")
                                    || (selected-page == "Completed" && download.status == "completed")
                                    || (selected-page == "Paused" && download.status == "paused")
                                    || (selected-page == "Failed" && download.status == "failed")) : HorizontalBox {
                                    padding: 8px;
                                    spacing: 12px;
                                    VerticalBox {
                                        horizontal-stretch: 3;
                                        Text { text: download.name; color: ink; font-weight: 600; }
                                        Text { text: download.url; color: muted; font-size: 11px; overflow: elide; }
                                        Button {
                                            text: selected-id == download.id ? "Selected" : "Details";
                                            clicked => { selected-id = download.id; transfer-message = "Selected download #" + download.id; }
                                        }
                                        Button {
                                            text: "Start";
                                            enabled: download.status != "downloading" && download.status != "completed";
                                            clicked => {
                                                selected-id = download.id;
                                                transfer-message = "Start requested for download #" + download.id;
                                                download-action(download.id, "start");
                                            }
                                        }
                                    }
                                    Text { text: download.status; horizontal-stretch: 1; color: ink; }
                                    Text { text: download.progress + "%"; horizontal-stretch: 1; color: ink; }
                                }
                            }
                        }
                    }
                    HorizontalBox {
                        Button { text: "Start"; enabled: selected-id >= 0; clicked => { transfer-message = "Start requested for #" + selected-id; download-action(selected-id, "start"); } }
                        Button { text: "Pause"; enabled: selected-id >= 0; clicked => { download-action(selected-id, "pause"); } }
                        Button { text: "Cancel"; enabled: selected-id >= 0; clicked => { download-action(selected-id, "cancel"); } }
                    }
                }
            }
            Text {
                text: "HTTP downloads • Validated HTTP range resume supported";
                color: muted;
                font-size: 12px;
            }
        }
    }
}
